# syntax=docker/dockerfile:1
FROM continuumio/miniconda3:py310-latest

SHELL ["/bin/bash", "-lc"]

# System deps (git to clone; optional: build tools if some wheels need compiling)
RUN apt-get update && apt-get install -y --no-install-recommends \
    git \
    && rm -rf /var/lib/apt/lists/*

WORKDIR /opt

# Clone repo
RUN git clone --depth 1 https://github.com/HilaSafi/DSE.git

WORKDIR /opt/DSE

# Create conda env
RUN conda create -y -n device_experiments python=3.10 && \
    conda clean -afy

# Install requirements from repo root (NOT src/)
RUN conda run -n device_experiments python -m pip install --upgrade pip && \
    conda run -n device_experiments pip install -r requirements.txt

# Copy entrypoint script into image
COPY entrypoint.sh /entrypoint.sh
RUN chmod +x /entrypoint.sh

# Default command: start interactive prompt script
ENTRYPOINT ["/entrypoint.sh"]
