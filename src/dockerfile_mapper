FROM continuumio/miniconda3:latest

SHELL ["/bin/bash", "-lc"]

# System deps (git + build toolchain for pip wheels that may need compiling)
RUN apt-get update && apt-get install -y --no-install-recommends \
    git ca-certificates \
    build-essential python3-dev \
    libffi-dev libssl-dev \
 && rm -rf /var/lib/apt/lists/*

# Clone repo
WORKDIR /opt
RUN git clone https://github.com/HilaSafi/DSE.git

# Repo root
WORKDIR /opt/DSE
ENV PYTHONPATH=/opt/DSE

# Create conda env (Python 3.10)
RUN conda update -n base -c defaults -y conda && \
    conda create -y -n mapper_experiments python=3.10 && \
    conda clean -afy

# Make env the default python/pip
ENV PATH=/opt/conda/envs/mapper_experiments/bin:$PATH

# Debug: show files and verify requirements exists
RUN echo "=== /opt/DSE contents ===" && ls -la && \
    test -f requirements_mapper.txt || (echo "ERROR: requirements_mapper.txt not found in /opt/DSE" && exit 1)

# Install mapper-only requirements (more robust + less caching issues)
RUN python -m pip install --upgrade pip setuptools wheel && \
    python -m pip install --no-cache-dir -r /opt/DSE/requirements_mapper.txt

# Entrypoint
COPY entrypoint_mapper.sh /usr/local/bin/entrypoint_mapper.sh
RUN chmod +x /usr/local/bin/entrypoint_mapper.sh

ENTRYPOINT ["/usr/local/bin/entrypoint_mapper.sh"]
CMD ["bash"]
