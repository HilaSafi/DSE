# syntax=docker/dockerfile:1
FROM continuumio/miniconda3:latest

SHELL ["/bin/bash", "-lc"]

# System deps
RUN apt-get update && apt-get install -y --no-install-recommends \
    git ca-certificates \
    build-essential python3-dev \
    libffi-dev libssl-dev \
 && rm -rf /var/lib/apt/lists/*

# Clone repo
WORKDIR /opt
RUN git clone --depth 1 https://github.com/HilaSafi/DSE.git

# Repo root
WORKDIR /opt/DSE

# Make repo + src importable
ENV PYTHONPATH=/opt/DSE:/opt/DSE/src

# Create conda env
RUN conda update -n base -c defaults -y conda && \
    conda create -y -n mapper_experiments python=3.10 && \
    conda clean -afy

# Ensure we are using the *env* python/pip at runtime too
ENV PATH=/opt/conda/envs/mapper_experiments/bin:$PATH

# Verify requirements exists in the repo (your file includes numpy==1.26.4, etc.) :contentReference[oaicite:0]{index=0}
RUN echo "=== /opt/DSE contents ===" && ls -la && \
    test -f /opt/DSE/requirements_mapper.txt || (echo "ERROR: requirements_mapper.txt not found in /opt/DSE" && exit 1)

# Install mapper requirements explicitly inside the conda env (do NOT rely on PATH)
RUN conda run -n mapper_experiments python -m pip install --upgrade pip setuptools wheel && \
    conda run -n mapper_experiments python -m pip install --no-cache-dir -r /opt/DSE/requirements_mapper.txt

# Build-time sanity checks (fail early if imports don't work)
RUN conda run -n mapper_experiments python -c "import sys; print('Python:', sys.executable)" && \
    conda run -n mapper_experiments python -c "import numpy; print('NumPy OK', numpy.__version__)" && \
    conda run -n mapper_experiments python -c "import qiskit; print('Qiskit OK', qiskit.__version__)"

# Entrypoint
COPY entrypoint_mapper.sh /usr/local/bin/entrypoint_mapper.sh
RUN chmod +x /usr/local/bin/entrypoint_mapper.sh

ENTRYPOINT ["/usr/local/bin/entrypoint_mapper.sh"]
CMD ["bash"]
